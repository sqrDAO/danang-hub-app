{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/mcp",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/register",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/authorize",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/consent-action",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/token",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/revoke",
        "function": {
          "functionId": "oauth",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://images.lumacdn.com https://secure-content.meetupstatic.com https://img.evbuc.com https://fonts.googleapis.com https://fonts.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com https://fcm.googleapis.com https://apis.google.com https://danang-hub-app.firebaseapp.com https://us-central1-danang-hub-app.cloudfunctions.net; frame-src 'self' https://danang-hub-app.firebaseapp.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
