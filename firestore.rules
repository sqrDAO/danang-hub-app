rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.membershipType == 'admin';
    }
    
    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Members collection
    // Profile fields: uid, displayName, email, photoURL, membershipType,
    // phone, bio, company, jobTitle, linkedIn, website, preferences (object),
    // locale ('en'|'vi', mirrors the UI language so Cloud Functions can
    // localize push copy), createdAt, updatedAt.
    // partnerId (id in /partners) is admin-set: the hourly partner-desk sync
    // (autoCheckoutExpiredBookings, functions/partnerDesks.js) keeps attached
    // members booked on their partner's desk.
    // Owners create with membershipType 'member' and no partnerId, and can
    // neither change nor remove either field afterwards; only admins can,
    // and only to 'member' or 'admin'.
    match /members/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Admins can read all members
      allow read: if isAdmin();
      // Users can create their own profile as a regular member, not attached
      // to a partner
      allow create: if isOwner(userId) &&
                       request.resource.data.get('membershipType', null) == 'member' &&
                       !('partnerId' in request.resource.data);
      // Users can update their own profile (except membershipType and partnerId,
      // which they may not change or remove)
      allow update: if isOwner(userId) &&
                       request.resource.data.get('membershipType', null) == resource.data.get('membershipType', null) &&
                       request.resource.data.get('partnerId', null) == resource.data.get('partnerId', null);
      // Only admins can update membershipType or any member. A profile with no
      // membershipType (legacy) reads as 'member' here, so admins can still
      // edit its other fields.
      allow update: if isAdmin() &&
                       request.resource.data.get('membershipType', 'member') in ['member', 'admin'];
      // Only admins can delete members
      allow delete: if isAdmin();
    }
    
    // Partner organizations (e.g. 9AM Games, DiiD): name, createdAt, updatedAt.
    // Members point at one via members.partnerId.
    match /partners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Amenities collection
    match /amenities/{amenityId} {
      // Everyone can read amenities (public access)
      allow read: if true;
      // Only admins can create, update, or delete amenities
      allow write: if isAdmin();
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      // A member may read only their own bookings. The booking calendar needs
      // other members' busy slots to grey them out, and cannot get them here:
      // rules are evaluated against the query rather than its results, so an
      // amenity-scoped list can never prove ownership. That occupancy comes
      // from the getAmenityBookingRanges callable, which returns start, end,
      // and status with no member identity attached. Widening this rule to
      // every signed-in user would hand out the whole booking schedule.
      // Users can read their own bookings
      allow read: if isAuthenticated() && isOwner(resource.data.memberId);
      // Admins can read all bookings
      allow read: if isAdmin();
      // Users can create their own bookings, always starting as pending
      // (auto-approval, if any, happens server-side); admins can create
      // on behalf of any member with any status. Partner Desk days are
      // written only by the server's hourly sync, so members cannot create
      // a partner-desk booking that the server would treat as one.
      allow create: if isAuthenticated() && isOwner(request.resource.data.memberId) &&
                       (!('status' in request.resource.data) ||
                        request.resource.data.status == 'pending') &&
                       request.resource.data.get('planType', null) != 'partner-desk' &&
                       (!('renewalOf' in request.resource.data) ||
                        (request.resource.data.renewalOf is string &&
                         request.resource.data.renewalOf.matches('^[A-Za-z0-9_-]{1,64}$') &&
                         request.resource.data.get('planType', null) == 'fixed-desk' &&
                         'planGroupId' in request.resource.data)) &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      allow create: if isAdmin() &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      // Users can update their own bookings (limited fields);
      // planGroupId is identity: may not be added, changed, or removed.
      // cancelledReason marks a cancellation made *for* the member by an admin
      // or script, and drives their cancellation notification — an owner who
      // could write it could forge that notice to themselves. renewalOf marks
      // a renewal day, which holds no seat while pending: an owner adding it
      // to a booking could free a seat they hold, or claim one they never had.
      // rejectionReason is the admin's note on a rejected renewal.
      allow update: if isAuthenticated() && isOwner(resource.data.memberId) &&
                       (!('status' in request.resource.data) || 
                        request.resource.data.status == resource.data.status ||
                        request.resource.data.status == 'cancelled') &&
                       !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['planGroupId', 'cancelledReason', 'renewalOf', 'rejectionReason']);
      // Admins can update any booking; planGroupId format still enforced when set
      allow update: if isAdmin() &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      // Users can delete their own pending bookings
      allow delete: if isAuthenticated() && isOwner(resource.data.memberId) && 
                       resource.data.status == 'pending';
      // Admins can delete any booking
      allow delete: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Everyone can read events (public access)
      allow read: if true;
      // Users can create events (they become the organizer), always as
      // 'pending' — self-approving at create time is an admin-only move.
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.organizerId) &&
                       request.resource.data.status == 'pending';
      // Admins can create an event in any status
      allow create: if isAdmin();
      // Organizer content editing is only through the editOwnEvent callable.
      // Any signed-in member may register / unregister / join / leave the
      // waitlist only while the event is live (approved).
      //
      // SCOPE: this restricts WHICH FIELDS a write may touch, never WHICH
      // ELEMENT changed inside them — rules have no array-diff primitive, so
      // a member can still write another member's uid into `attendees`. That
      // is accepted: the blast radius is a wrong name on an attendee list,
      // while status/capacity/date/organizerId stay locked. Closing it means
      // moving attendee writes behind a callable that checks request.auth.uid.
      allow update: if isAuthenticated() &&
                       resource.data.status == 'approved' &&
                       request.resource.data.status == 'approved' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['attendees', 'waitlist']);
      // Admins can update any event
      allow update: if isAdmin();
      // Organizers can delete their own events, but only while still pending.
      // Mirrors the bookings rule above: once an event is approved it has
      // attendees and a waitlist, and a bare deleteDoc would erase every
      // registration with no notification and no recovery. The member UI only
      // renders delete for pending events, but the rule is the enforcement
      // layer — a direct client write must not get past this.
      allow delete: if isAuthenticated() && isOwner(resource.data.organizerId) &&
                       resource.data.status == 'pending' &&
                       (!('everApproved' in resource.data) ||
                        resource.data.everApproved == false);
      // Admins can delete any event
      allow delete: if isAdmin();
    }
    
    // Projects collection
    match /projects/{projectId} {
      // Everyone can read projects (public access)
      allow read: if true;
      // Only admins can create, update, or delete projects
      allow write: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Users can mark their own notifications as read (update only the read field)
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Only Cloud Functions (admin SDK) create notifications — no client-side create/delete
    }

    // Browser push tokens are private client writes. Cloud Functions read them
    // through the Admin SDK; no client should read tokens back from Firestore.
    match /push_tokens/{userId} {
      allow read: if false;
      allow create, update, delete: if isOwner(userId);
    }
  }
}
