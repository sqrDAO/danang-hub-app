rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.membershipType == 'admin';
    }
    
    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A partner's desk (amenities.reservedForPartnerId, set from the admin
    // Partners panel) is bookable only by members attached to that partner.
    // A missing amenity reads as unreserved, so this never errors on its own.
    // Two documents read (the amenity and the caller's profile, which isAdmin
    // already reads in the same request).
    function amenityOpenToCaller(amenityId) {
      let amenityPath = /databases/$(database)/documents/amenities/$(amenityId);
      let memberPath = /databases/$(database)/documents/members/$(request.auth.uid);
      return !exists(amenityPath) ||
             get(amenityPath).data.get('reservedForPartnerId', null) == null ||
             (exists(memberPath) &&
              get(memberPath).data.get('partnerId', null) == get(amenityPath).data.reservedForPartnerId);
    }
    
    // Members collection
    // Profile fields: uid, displayName, email, verifiedEmail, photoURL, membershipType,
    // phone (E.164, src/utils/phone.js), gender (optional, self-reported, for
    // aggregate SDG 5 reporting), bio, company, jobTitle, linkedIn, website,
    // preferences (object),
    // locale ('en'|'vi', mirrors the UI language so Cloud Functions can
    // localize push copy), createdAt, updatedAt.
    // partnerId (id in /partners) is admin-set: the hourly partner-desk sync
    // (autoCheckoutExpiredBookings, functions/partnerDesks.js) keeps attached
    // members booked on their partner's desk.
    // Owners create with membershipType 'member' and no partnerId, and can
    // neither change nor remove either field afterwards; only admins can,
    // and only to 'member' or 'admin'.
    // email mirrors the caller's Auth email (AuthContext syncs it), so an owner
    // with one may set it only to that (or leave it unchanged). A wallet account
    // has no Auth email and types its own contact address. System mail never
    // reads this field: it goes only to a verified Auth email.
    function ownerEmailAllowed(before) {
      let email = request.resource.data.get('email', '');
      let authEmail = request.auth.token.get('email', '');
      return authEmail == '' || email == authEmail || email == before;
    }

    // Only the owner's verified Auth token can assert proof for an address.
    // Keeping old proof is safe: the UI requires it to match the current email.
    // Admins may clear proof, but cannot verify someone else's typed address.
    function verifiedEmailAllowed(userId, before) {
      let verifiedEmail = request.resource.data.get('verifiedEmail', '');
      return verifiedEmail == before || verifiedEmail == '' ||
             (isOwner(userId) && request.auth.token.get('email_verified', false) == true &&
              verifiedEmail == request.auth.token.get('email', '') &&
              verifiedEmail == request.resource.data.get('email', ''));
    }

    // An owner writes phone as E.164 or empty. Unchanged always passes, so an
    // older free-text number never blocks an unrelated write (locale, email sync).
    function ownerPhoneAllowed(before) {
      let phone = request.resource.data.get('phone', '');
      return phone == before || phone == '' ||
             (phone is string && phone.matches('[+][1-9][0-9]{7,14}'));
    }

    // gender: one of GENDER_OPTIONS (src/utils/profileFields.js), empty, or unchanged.
    function ownerGenderAllowed(before) {
      let gender = request.resource.data.get('gender', '');
      return gender == before ||
             gender in ['', 'female', 'male', 'other', 'prefer-not-to-say'];
    }

    match /members/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Admins can read all members
      allow read: if isAdmin();
      // Users can create their own profile as a regular member, not attached
      // to a partner
      allow create: if isOwner(userId) &&
                       request.resource.data.get('membershipType', null) == 'member' &&
                       !('partnerId' in request.resource.data) &&
                       ownerEmailAllowed('') && verifiedEmailAllowed(userId, '') &&
                       ownerPhoneAllowed('') && ownerGenderAllowed('');
      // Users can update their own profile (except membershipType and partnerId,
      // which they may not change or remove, and email, which follows their
      // Auth email when they have one)
      allow update: if isOwner(userId) &&
                       request.resource.data.get('membershipType', null) == resource.data.get('membershipType', null) &&
                       request.resource.data.get('partnerId', null) == resource.data.get('partnerId', null) &&
                       ownerEmailAllowed(resource.data.get('email', '')) &&
                       verifiedEmailAllowed(userId, resource.data.get('verifiedEmail', '')) &&
                       ownerPhoneAllowed(resource.data.get('phone', '')) &&
                       ownerGenderAllowed(resource.data.get('gender', ''));
      // Only admins can update membershipType or any member. A profile with no
      // membershipType (legacy) reads as 'member' here, so admins can still
      // edit its other fields.
      allow update: if isAdmin() &&
                       request.resource.data.get('membershipType', 'member') in ['member', 'admin'] &&
                       verifiedEmailAllowed(userId, resource.data.get('verifiedEmail', ''));
      // Only admins can delete members
      allow delete: if isAdmin();
    }
    
    // Partner organizations (e.g. 9AM Games, DiiD): name, createdAt, updatedAt.
    // Members point at one via members.partnerId.
    match /partners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Amenities collection. reservedForPartnerId (id in /partners, optional)
    // marks a partner's desk; see amenityOpenToCaller.
    match /amenities/{amenityId} {
      // Everyone can read amenities (public access)
      allow read: if true;
      // Only admins can create, update, or delete amenities
      allow write: if isAdmin();
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      // A member may read only their own bookings. The booking calendar needs
      // other members' busy slots to grey them out, and cannot get them here:
      // rules are evaluated against the query rather than its results, so an
      // amenity-scoped list can never prove ownership. That occupancy comes
      // from the getAmenityBookingRanges callable, which returns start, end,
      // and status with no member identity attached. Widening this rule to
      // every signed-in user would hand out the whole booking schedule.
      // Users can read their own bookings
      allow read: if isAuthenticated() && isOwner(resource.data.memberId);
      // Admins can read all bookings
      allow read: if isAdmin();
      // Users can create their own bookings, always starting as pending
      // (auto-approval, if any, happens server-side); admins can create
      // on behalf of any member with any status. Partner Desk days are
      // written only by the server's hourly sync, so members cannot create
      // a partner-desk booking that the server would treat as one. A desk
      // reserved for a partner takes bookings only from that partner's members.
      // Fields only an admin or the server writes cannot be set at create
      // either, and the pd_ ids and partner_ plan groups the sync uses for
      // Partner Desk days are the server's alone. The MCP server stamps
      // source through the Admin SDK. Client writes must preserve its origin.
      allow create: if isAuthenticated() && isOwner(request.resource.data.memberId) &&
                       !('source' in request.resource.data) &&
                       (!('status' in request.resource.data) ||
                        request.resource.data.status == 'pending') &&
                       !bookingId.matches('^pd_.*') &&
                       !request.resource.data.keys().hasAny(['cancelledReason', 'rejectionReason',
                                                             'limitHoursLeft', 'limitMonth', 'partnerId',
                                                             'checkInTime', 'checkOutTime']) &&
                       !request.resource.data.get('planGroupId', '').matches('^partner_.*') &&
                       amenityOpenToCaller(request.resource.data.amenityId) &&
                       request.resource.data.get('planType', null) != 'partner-desk' &&
                       // A Fixed Desk day belongs to a plan. Desk plans sit
                       // outside the monthly desk-hours limit, and always go
                       // to an admin, so an ungrouped one would just be a
                       // single booking dodging the limit.
                       (request.resource.data.get('planType', null) != 'fixed-desk' ||
                        'planGroupId' in request.resource.data) &&
                       (!('renewalOf' in request.resource.data) ||
                        (request.resource.data.renewalOf is string &&
                         request.resource.data.renewalOf.matches('^[A-Za-z0-9_-]{1,64}$') &&
                         request.resource.data.get('planType', null) == 'fixed-desk' &&
                         'planGroupId' in request.resource.data)) &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      allow create: if isAdmin() &&
                       !('source' in request.resource.data) &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      // Users can update their own bookings only to cancel them: status and
      // updatedAt are the only fields they may touch. Everything else is fixed
      // once written. Conflict checks, auto-approval and the monthly
      // desk-hours limit all judge a booking when it is created, and plan
      // fields (planType, planGroupId, planPeriod, renewalOf) decide seats,
      // limits and renewals; cancelledReason, rejectionReason and the limit
      // fields are admin or server marks that drive the member's notices.
      // An approved booking counts toward the monthly desk-hours limit and
      // can't be cancelled by its owner (#150); approved desk-plan days can,
      // since they sit outside the limit. planType, not planGroupId: owners
      // can't change planType, but may set any planGroupId at create.
      // status must stay present, since the limit counts bookings by status.
      allow update: if isAuthenticated() && isOwner(resource.data.memberId) &&
                       'status' in request.resource.data &&
                       (request.resource.data.status == resource.data.status ||
                        (request.resource.data.status == 'cancelled' &&
                         (resource.data.status == 'pending' ||
                          (resource.data.status == 'approved' &&
                           resource.data.get('planType', null) in ['fixed-desk', 'partner-desk'])))) &&
                       request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status', 'updatedAt']);
      // Admins can update any booking while preserving its source.
      allow update: if isAdmin() &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['source']) &&
                       (!('planGroupId' in request.resource.data) ||
                        (request.resource.data.planGroupId is string &&
                         request.resource.data.planGroupId.matches('^[A-Za-z0-9_-]{1,64}$')));
      // Users can delete their own pending bookings
      allow delete: if isAuthenticated() && isOwner(resource.data.memberId) && 
                       resource.data.status == 'pending';
      // Admins can delete any booking
      allow delete: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Everyone can read events (public access)
      allow read: if true;
      // Users can create events (they become the organizer), always as
      // 'pending' — self-approving at create time is an admin-only move.
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.organizerId) &&
                       request.resource.data.status == 'pending';
      // Admins can create an event in any status
      allow create: if isAdmin();
      // Organizer content editing is only through the editOwnEvent callable.
      // Any signed-in member may register / unregister / join / leave the
      // waitlist only while the event is live (approved).
      //
      // SCOPE: this restricts WHICH FIELDS a write may touch, never WHICH
      // ELEMENT changed inside them — rules have no array-diff primitive, so
      // a member can still write another member's uid into `attendees`. That
      // is accepted: the blast radius is a wrong name on an attendee list,
      // while status/capacity/date/organizerId stay locked. Closing it means
      // moving attendee writes behind a callable that checks request.auth.uid.
      allow update: if isAuthenticated() &&
                       resource.data.status == 'approved' &&
                       request.resource.data.status == 'approved' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['attendees', 'waitlist']);
      // Admins can update any event
      allow update: if isAdmin();
      // Organizers can delete their own events, but only while still pending.
      // Mirrors the bookings rule above: once an event is approved it has
      // attendees and a waitlist, and a bare deleteDoc would erase every
      // registration with no notification and no recovery. The member UI only
      // renders delete for pending events, but the rule is the enforcement
      // layer — a direct client write must not get past this.
      allow delete: if isAuthenticated() && isOwner(resource.data.organizerId) &&
                       resource.data.status == 'pending' &&
                       (!('everApproved' in resource.data) ||
                        resource.data.everApproved == false);
      // Admins can delete any event
      allow delete: if isAdmin();
    }
    
    // Projects collection
    match /projects/{projectId} {
      // Everyone can read projects (public access)
      allow read: if true;
      // Only admins can create, update, or delete projects
      allow write: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Users can mark their own notifications as read (update only the read field)
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Only Cloud Functions (admin SDK) create notifications — no client-side create/delete
    }

    match /importRateLimits/{uid} {
      allow read, write: if false;
    }

    // MCP OAuth authorization server state (#263): written and read only by
    // the `oauth` and `oauthConsent` functions through the Admin SDK. Codes
    // and tokens are stored as SHA-256 hashes. Never open these to clients.
    match /oauthClients/{clientId} {
      allow read, write: if false;
    }
    match /oauthRequests/{requestId} {
      allow read, write: if false;
    }
    match /oauthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /oauthGrants/{grantId} {
      allow read, write: if false;
    }
    match /oauthTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /oauthRateLimits/{limitId} {
      allow read, write: if false;
    }

    // Browser push tokens are private client writes. Cloud Functions read them
    // through the Admin SDK; no client should read tokens back from Firestore.
    match /push_tokens/{userId} {
      allow read: if false;
      // Legacy documents cannot be recreated after migration.
      allow delete: if isOwner(userId);

      // One doc per phone, keyed by a random id the phone keeps, so each phone
      // overwrites only its own token.
      match /devices/{deviceId} {
        allow read: if false;
        allow create, update: if isOwner(userId) &&
                                 request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
                                 request.resource.data.token is string &&
                                 request.resource.data.token.size() > 0 &&
                                 request.resource.data.token.size() <= 4096 &&
                                 request.resource.data.platform == 'web' &&
                                 request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }
    }
  }
}
